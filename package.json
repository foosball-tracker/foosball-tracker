{
  "name": "foosball-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status -o env",
    "db:reset": "supabase db reset",
    "db:migration:new": "supabase migration new",
    "db-types": "supabase gen types typescript --local --schema public > src/types/database.ts",
    "db:types": "supabase gen types typescript --local --schema public > src/types/database.ts",
    "db:seed:auth": "tsx scripts/seed-local-auth.ts",
    "local:setup": "npm run supabase:start && npm run db:reset && npm run db:seed:auth",
    "local:reset": "npm run db:reset && npm run db:seed:auth",
    "local:dev": "npm run supabase:start && npm run dev",
    "db:push:remote": "supabase db push",
    "ui:inspect:start": "node scripts/ui-inspect-start.mjs",
    "ui:inspect:stop": "node scripts/ui-inspect-stop.mjs",
    "ui:inspect:status": "node scripts/ui-inspect-status.mjs",
    "auth:local": "node scripts/auth-local.mjs",
    "proof:capture": "node scripts/screenshot-auth.mjs",
    "proof:publish": "node scripts/proof-publish.mjs",
    "test:e2e": "playwright test",
    "design:lint": "npx @google/design.md lint DESIGN.md",
    "design:spec": "npx @google/design.md spec --rules",
    "design:export": "npx @google/design.md export --format tailwind DESIGN.md",
    "design:detect": "npx impeccable detect src/"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,json,md,toml,yaml,yml}": "prettier --write",
    ".prettierrc": "prettier --write"
  },
  "dependencies": {
    "@solid-primitives/scheduled": "^1.5.3",
    "@solidjs/router": "^0.16.1",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/solid-table": "^8.21.3",
    "lucide-solid": "^1.16.0",
    "solid-js": "^1.9.13"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@zeplin/mcp-server": "^1.0.5",
    "daisyui": "5.5.19",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prettier-plugin-toml": "^2.0.6",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.3",
    "tsx": "^4.20.6",
    "vite": "^6.4.2",
    "vite-plugin-solid": "^2.11.12",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
