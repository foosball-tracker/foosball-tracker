# Local Supabase values for day-to-day development.
# Copy these values into `.env.local` if you want to run `pnpm dev` manually.
# Automated local flows already inject the local Supabase env for you.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<local-anon-key-from-supabase-status>
VITE_SUPABASE_PROJECT_ID=foosball-tracker
VITE_CONTEXT=local
